# Local scratch files and additional backups; tracked history is retained.
/backups/
/tmp/

# SolidWorks locks, recovery files and uncompressed preview intermediates.
~$*
*.sldbak
*.sldrecover
/output/mechanics/**/*.bmp

__pycache__/
*.pyc

# Reproducible host-test dependencies and disposable object files.
/node_modules/
/output/**/objects/

# Local scratch, host test executables, and unapplied browser-form backup.
/work/
/output/**/*.exe
/output/**/pre-refresh-form-draft.json
